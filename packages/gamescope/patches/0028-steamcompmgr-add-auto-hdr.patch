+#include <catch2/catch_test_macros.hpp>
+
+#include "auto_hdr.h"
+
+using namespace gamescope;
+
+TEST_CASE( "Auto HDR is opt-in", "[auto_hdr]" )
+{
+	REQUIRE_FALSE( AutoHdrUsesItm( false, true, false, true, false ) );
+}
+
+TEST_CASE( "Auto HDR inverse tone maps only SDR base layers", "[auto_hdr]" )
+{
+	REQUIRE_FALSE( AutoHdrUsesItm( true, false, false, true, false ) );
+	REQUIRE_FALSE( AutoHdrUsesItm( true, true, false, false, false ) );
+	REQUIRE( AutoHdrUsesItm( true, true, false, true, false ) );
+	REQUIRE_FALSE( AutoHdrUsesItm( true, true, true, true, false ) );
+	REQUIRE_FALSE( AutoHdrUsesItm( true, true, false, true, true ) );
+}
