new file mode 100644
index 0000000..86f47f3
--- /dev/null
+++ b/tests/test_auto_hdr.cpp
@@ -0,0 +1,46 @@
+#include <catch2/catch_approx.hpp>
+#include <catch2/catch_test_macros.hpp>
+
+#include "auto_hdr.h"
+
+using namespace gamescope;
+
+TEST_CASE( "Auto HDR is opt-in", "[auto_hdr]" )
+{
+	REQUIRE_FALSE( AutoHdrIsEligible( true, false, true, false, true, false ) );
+}
+
+TEST_CASE( "Auto HDR requires an eligible SDR game layer", "[auto_hdr]" )
+{
+	REQUIRE_FALSE( AutoHdrIsEligible( false, true, true, false, true, false ) );
+	REQUIRE_FALSE( AutoHdrIsEligible( true, true, false, false, true, false ) );
+	REQUIRE_FALSE( AutoHdrIsEligible( true, true, true, false, false, false ) );
+	REQUIRE( AutoHdrIsEligible( true, true, true, false, true, false ) );
+	REQUIRE_FALSE( AutoHdrIsEligible( true, true, true, true, true, false ) );
+	REQUIRE_FALSE( AutoHdrIsEligible( true, true, true, false, true, true ) );
+}
+
+TEST_CASE( "Auto HDR direct scanout needs a compatible plane pipeline", "[auto_hdr]" )
+{
+	REQUIRE_FALSE( AutoHdrUsesDirectScanout( false, true, true, true ) );
+	REQUIRE_FALSE( AutoHdrUsesDirectScanout( true, false, true, true ) );
+	REQUIRE_FALSE( AutoHdrUsesDirectScanout( true, true, false, true ) );
+	REQUIRE_FALSE( AutoHdrUsesDirectScanout( true, true, true, false ) );
+	REQUIRE( AutoHdrUsesDirectScanout( true, true, true, true ) );
+}
+
+TEST_CASE( "Auto HDR tone mapping keeps black black", "[auto_hdr]" )
+{
+	const glm::vec3 black = AutoHdrInverseToneMap( glm::vec3( 0.0f ), 100.0f, 1000.0f );
+	REQUIRE( black.r == 0.0f );
+	REQUIRE( black.g == 0.0f );
+	REQUIRE( black.b == 0.0f );
+}
+
+TEST_CASE( "Auto HDR tone mapping keeps color proportions", "[auto_hdr]" )
+{
+	const glm::vec3 input{ 0.36f, 0.16f, 0.04f };
+	const glm::vec3 mapped = AutoHdrInverseToneMap( input, 100.0f, 700.0f );
+	REQUIRE( mapped.r / mapped.g == Catch::Approx( input.r / input.g ).epsilon( 0.0001f ) );
+	REQUIRE( mapped.g / mapped.b == Catch::Approx( input.g / input.b ).epsilon( 0.0001f ) );
+}
