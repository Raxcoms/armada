+static glm::vec3 sample_color_mgmt_lut1d( const gamescope_color_mgmt_luts &luts, glm::vec3 input )
+{
+	input = glm::clamp( input, glm::vec3( 0.0f ), glm::vec3( 1.0f ) ) * float( s_nLutSize1d - 1 );
+	const auto sample = [&]( float value, uint32_t component )
+	{
+		const uint32_t index = uint32_t( value );
+		const uint32_t next = std::min( index + 1, s_nLutSize1d - 1 );
+		const float fraction = value - float( index );
+		return std::lerp( float( luts.lut1d[index * 4 + component] ), float( luts.lut1d[next * 4 + component] ), fraction ) / float( UINT16_MAX );
+	};
+	return { sample( input.r, 0 ), sample( input.g, 1 ), sample( input.b, 2 ) };
+}
+
+static glm::vec3 sample_color_mgmt_lut3d( const gamescope_color_mgmt_luts &luts, glm::vec3 input )
+{
+	constexpr uint32_t kEdge = s_nLutEdgeSize3d;
+	input = glm::clamp( input, glm::vec3( 0.0f ), glm::vec3( 1.0f ) ) * float( kEdge - 1 );
+	const glm::uvec3 low = glm::uvec3( input );
+	const glm::uvec3 high = glm::min( low + 1u, glm::uvec3( kEdge - 1 ) );
+	const glm::vec3 fraction = input - glm::vec3( low );
+	const auto sample = [&]( glm::uvec3 index )
+	{
+		const uint32_t offset = index.r + index.g * kEdge + index.b * kEdge * kEdge;
+		return glm::vec3( luts.lut3d[offset * 4], luts.lut3d[offset * 4 + 1], luts.lut3d[offset * 4 + 2] ) / float( UINT16_MAX );
+	};
+	const glm::vec3 c00 = glm::mix( sample( { low.r, low.g, low.b } ), sample( { high.r, low.g, low.b } ), fraction.r );
+	const glm::vec3 c10 = glm::mix( sample( { low.r, high.g, low.b } ), sample( { high.r, high.g, low.b } ), fraction.r );
+	const glm::vec3 c01 = glm::mix( sample( { low.r, low.g, high.b } ), sample( { high.r, low.g, high.b } ), fraction.r );
+	const glm::vec3 c11 = glm::mix( sample( { low.r, high.g, high.b } ), sample( { high.r, high.g, high.b } ), fraction.r );
+	return glm::mix( glm::mix( c00, c10, fraction.g ), glm::mix( c01, c11, fraction.g ), fraction.b );
+}
+
+static void update_auto_hdr_direct_luts()
+{
+	g_AutoHdrDirectLuts.reset();
+	if ( !g_ColorMgmtLuts[EOTF_PQ].HasLuts() )
+	{
+		g_AutoHdrDirectLutSerial++;
+		return;
+	}
+
+	for ( uint32_t i = 0; i < s_nLutSize1d; i++ )
+	{
+		const uint16_t value = quantize_lut_value_16bit( float( i ) / float( s_nLutSize1d - 1 ) );
+		g_AutoHdrDirectLuts.lut1d[i * 4] = value;
+		g_AutoHdrDirectLuts.lut1d[i * 4 + 1] = value;
+		g_AutoHdrDirectLuts.lut1d[i * 4 + 2] = value;
+		g_AutoHdrDirectLuts.lut1d[i * 4 + 3] = 0;
+	}
+
+	for ( uint32_t b = 0; b < s_nLutEdgeSize3d; b++ )
+	{
+		for ( uint32_t g = 0; g < s_nLutEdgeSize3d; g++ )
+		{
+			for ( uint32_t r = 0; r < s_nLutEdgeSize3d; r++ )
+			{
+				const glm::vec3 input{
+					float( r ) / float( s_nLutEdgeSize3d - 1 ),
+					float( g ) / float( s_nLutEdgeSize3d - 1 ),
+					float( b ) / float( s_nLutEdgeSize3d - 1 ),
+				};
+				const glm::vec3 linearInput{
+					srgb_to_linear( input.r ),
+					srgb_to_linear( input.g ),
+					srgb_to_linear( input.b ),
+				};
+				glm::vec3 color = gamescope::AutoHdrInverseToneMap(
+					k_2020_from_709 * linearInput,
+					g_flHDRItmSdrNits, g_flHDRItmTargetNits );
+				color = sample_color_mgmt_lut3d( g_ColorMgmtLuts[EOTF_PQ], sample_color_mgmt_lut1d( g_ColorMgmtLuts[EOTF_PQ], nits_to_pq( color ) ) );
+
+				const uint32_t index = r + g * s_nLutEdgeSize3d + b * s_nLutEdgeSize3d * s_nLutEdgeSize3d;
+				g_AutoHdrDirectLuts.lut3d[index * 4] = quantize_lut_value_16bit( color.r );
+				g_AutoHdrDirectLuts.lut3d[index * 4 + 1] = quantize_lut_value_16bit( color.g );
+				g_AutoHdrDirectLuts.lut3d[index * 4 + 2] = quantize_lut_value_16bit( color.b );
+				g_AutoHdrDirectLuts.lut3d[index * 4 + 3] = 0;
+			}
+		}
+	}
+
+	g_AutoHdrDirectLuts.bHasLut1D = true;
+	g_AutoHdrDirectLuts.bHasLut3D = true;
+	if ( !g_AutoHdrDirectLuts.vk_lut1d )
+		g_AutoHdrDirectLuts.vk_lut1d = vulkan_create_1d_lut( s_nLutSize1d );
+	if ( !g_AutoHdrDirectLuts.vk_lut3d )
+		g_AutoHdrDirectLuts.vk_lut3d = vulkan_create_3d_lut( s_nLutEdgeSize3d, s_nLutEdgeSize3d, s_nLutEdgeSize3d );
+	vulkan_update_luts( g_AutoHdrDirectLuts.vk_lut1d, g_AutoHdrDirectLuts.vk_lut3d,
+		g_AutoHdrDirectLuts.lut1d, g_AutoHdrDirectLuts.lut3d );
+	g_AutoHdrDirectLutSerial++;
+}
