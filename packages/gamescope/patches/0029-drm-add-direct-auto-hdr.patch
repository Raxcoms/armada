+	drm->pending.auto_hdr_lut_serial = g_AutoHdrDirectLutSerial;
 
 	for ( uint32_t i = 0; i < EOTF_Count; i++ )
 	{
diff --git a/src/auto_hdr.h b/src/auto_hdr.h
new file mode 100644
index 0000000..ee04e42
--- /dev/null
+++ b/src/auto_hdr.h
@@ -0,0 +1,76 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+#include <glm/vec3.hpp>
+
+namespace gamescope
+{
+	constexpr bool AutoHdrIsEligible(
+		bool primaryOutput,
+		bool autoHdrEnabled,
+		bool hdrOutputCapable,
+		bool baseLayerIsHdr,
+		bool baseLayerIsEligible,
+		bool legacyItmEnabled )
+	{
+		return primaryOutput && autoHdrEnabled && hdrOutputCapable && !baseLayerIsHdr &&
+			baseLayerIsEligible && !legacyItmEnabled;
+	}
+
+	constexpr bool AutoHdrUsesDirectScanout(
+		bool autoHdrEnabled,
+		bool planeLutsAvailable,
+		bool baseLayerUsesColorMgmt,
+		bool baseLayerIsSdr )
+	{
+		return autoHdrEnabled && planeLutsAvailable && baseLayerUsesColorMgmt && baseLayerIsSdr;
+	}
+
+	inline glm::vec3 AutoHdrInverseToneMap( glm::vec3 color, float sdrNits, float targetNits )
+	{
+		const glm::vec3 kBt2020{ 0.262698338956556f, 0.678008765772817f, 0.0592928952706273f };
+		constexpr float kRed = 1.47460332208689f;
+		constexpr float kBlue = 1.88141420945875f;
+		constexpr float kInverseGamma = 2.4f;
+		constexpr float kGamma = 1.0f / kInverseGamma;
+
+		color = { std::pow( color.r, kGamma ), std::pow( color.g, kGamma ), std::pow( color.b, kGamma ) };
+		const glm::vec3 source = color;
+		const float yTmo = color.r * kBt2020.r + color.g * kBt2020.g + color.b * kBt2020.b;
+		const float cbTmo = ( color.b - yTmo ) / kBlue;
+		const float crTmo = ( color.r - yTmo ) / kRed;
+
+		const float ySdr = yTmo + std::max( 0.1f * crTmo, 0.0f );
+		const float pSdr = 1.0f + 32.0f * std::pow( sdrNits / 10000.0f, kGamma );
+		const float yC = std::log( ySdr * ( pSdr - 1.0f ) + 1.0f ) / std::log( pSdr );
+		const float yP0 = yC / 1.0770f;
+		const float yP1 = ( -2.7811f + std::sqrt( 4.83307641f - 4.604f * yC ) ) / -2.302f;
+		const float yP2 = ( yC - 0.5000f ) / 0.5000f;
+		const float yP = yP0 <= 0.7399f ? yP0 : yP1 > 0.7399f && yP1 < 0.9909f ? yP1 : yP2 >= 0.9909f ? yP2 : yP1;
+		const float pHdr = 1.0f + 32.0f * std::pow( targetNits / 10000.0f, kGamma );
+		const float y = ( std::pow( pHdr, yP ) - 1.0f ) / ( pHdr - 1.0f );
+		const float chromaScale = y > 0.0f ? ySdr / ( 1.1f * y ) : 0.0f;
+
+		color.b = chromaScale > 0.0f ? cbTmo * kBlue / chromaScale + y : y;
+		color.r = chromaScale > 0.0f ? crTmo * kRed / chromaScale + y : y;
+		color.g = ( y - kBt2020.r * color.r - kBt2020.b * color.b ) / kBt2020.g;
+		color.r = std::clamp( color.r, 0.0f, 1.0f );
+		color.g = std::clamp( color.g, 0.0f, 1.0f );
+		color.b = std::clamp( color.b, 0.0f, 1.0f );
+
+		// Keep the BT.2446 luminance curve while preserving the source hue.
+		const float mappedLuma = color.r * kBt2020.r + color.g * kBt2020.g + color.b * kBt2020.b;
+		const float lumaScale = yTmo > 0.0f ? mappedLuma / yTmo : 0.0f;
+		color = {
+			std::clamp( source.r * lumaScale, 0.0f, 1.0f ),
+			std::clamp( source.g * lumaScale, 0.0f, 1.0f ),
+			std::clamp( source.b * lumaScale, 0.0f, 1.0f ),
+		};
+
+		return { std::pow( color.r, kInverseGamma ) * targetNits,
+			std::pow( color.g, kInverseGamma ) * targetNits,
+			std::pow( color.b, kInverseGamma ) * targetNits };
+	}
+}
