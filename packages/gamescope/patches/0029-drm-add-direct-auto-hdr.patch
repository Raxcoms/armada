+		lut3D = GetBackend()->CreateBackendBlob( *pLut3D );
+		return shaperLut && lut3D;
+	};
+
+	for ( uint32_t e = 0; e < EOTF_Count; e++ )
+	{
+		if ( !CreateLutBlobs( g_ColorMgmtLuts[e], drm->pending.shaperlut_id[e], drm->pending.lut3d_id[e] ) )
 			return false;
 	}
-	return true;
+
+	return CreateLutBlobs( g_AutoHdrDirectLuts, drm->pending.auto_hdr_shaperlut_id, drm->pending.auto_hdr_lut3d_id );
 }
 
 bool drm_update_color_mgmt(struct drm_t *drm)
 {
